{{--
    TinyMCE WYSIWYG Editor Component

    A reusable rich text editor component with multi-language support, RTL handling,
    and integration with The Last Messenger admin dashboard theme.

    @props
    - name: string (required) - Field name for form submission
    - value: string (optional) - Initial content value
    - language: string (optional) - Content language (ar, en, fr, tr, ur)
    - height: int (optional) - Editor height in pixels (default: 500)
    - required: bool (optional) - Whether field is required
    - disabled: bool (optional) - Whether editor is disabled
    - placeholder: string (optional) - Placeholder text
    - id: string (optional) - Custom ID for the editor

    @example
    <x-admin.editor
        name="content[ar]"
        :value="$article->content['ar'] ?? ''"
        language="ar"
        :required="true"
        placeholder="اكتب محتوى المقال هنا..."
    />
--}}

@props([
    'name' => '',
    'value' => '',
    'language' => 'ar',
    'height' => 500,
    'required' => false,
    'disabled' => false,
    'placeholder' => '',
    'id' => null
])

@php
    // Generate unique ID if not provided
    $editorId = $id ?? 'tinymce_' . md5($name . uniqid());

    // Determine text direction based on language
    $isRtl = in_array($language, ['ar', 'ur', 'fa', 'he']);
    $directionality = $isRtl ? 'rtl' : 'ltr';

    // Language code mapping for TinyMCE
    $languageMap = [
        'ar' => 'ar',
        'en' => 'en',
        'fr' => 'fr_FR',
        'tr' => 'tr',
        'ur' => 'ar' // Use Arabic for Urdu (similar RTL support)
    ];

    $tinyLanguage = $languageMap[$language] ?? 'en';
@endphp

<div class="tinymce-wrapper" x-data="tinymceEditor({
    id: '{{ $editorId }}',
    name: '{{ $name }}',
    language: '{{ $language }}',
    direction: '{{ $directionality }}',
    height: {{ $height }},
    required: {{ $required ? 'true' : 'false' }},
    disabled: {{ $disabled ? 'true' : 'false' }},
    placeholder: '{{ $placeholder }}'
})" x-init="initEditor()">

    <!-- Loading State -->
    <div x-show="!editorReady" class="editor-loading" :class="$root.closest('[x-data]')?.darkMode ? 'bg-gray-800 border-gray-700' : 'bg-gray-50 border-gray-300'"
         style="height: {{ $height }}px; border: 1px solid; border-radius: 0.5rem; display: flex; align-items: center; justify-content: center;">
        <div class="text-center">
            <i data-lucide="loader-2" class="w-8 h-8 animate-spin mx-auto mb-2" :class="$root.closest('[x-data]')?.darkMode ? 'text-gray-400' : 'text-gray-600'"></i>
            <p class="text-sm" :class="$root.closest('[x-data]')?.darkMode ? 'text-gray-400' : 'text-gray-600'">
                {{ $language === 'ar' ? 'جاري تحميل المحرر...' : 'Loading editor...' }}
            </p>
        </div>
    </div>

    <!-- Editor Error State -->
    <div x-show="editorError && !editorReady" x-cloak class="p-4 rounded-lg border border-red-500 bg-red-50 dark:bg-red-900/20">
        <div class="flex items-center gap-2 text-red-600 dark:text-red-400">
            <i data-lucide="alert-circle" class="w-5 h-5"></i>
            <span class="font-semibold">Failed to load editor</span>
        </div>
        <p class="text-sm mt-2 text-red-700 dark:text-red-300" x-text="editorError"></p>
        <button type="button" @click="initEditor()" class="mt-3 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors text-sm">
            Retry
        </button>
    </div>

    <!-- Textarea (TinyMCE will replace this) -->
    <textarea
        id="{{ $editorId }}"
        name="{{ $name }}"
        class="tinymce-textarea"
        dir="{{ $directionality }}"
        style="visibility: hidden;"
        {{ $required ? 'required' : '' }}
        {{ $disabled ? 'disabled' : '' }}
        placeholder="{{ $placeholder }}"
    >{{ old($name, $value) }}</textarea>

    <!-- Character Count (optional) -->
    <div x-show="editorReady" x-cloak class="mt-2 text-xs flex items-center justify-between" :class="$root.closest('[x-data]')?.darkMode ? 'text-gray-400' : 'text-gray-600'">
        <span>
            <i data-lucide="file-text" class="w-3 h-3 inline-block ml-1"></i>
            Word count: <span x-text="wordCount" class="font-semibold">0</span>
        </span>
        <span x-show="required && wordCount < 10" class="text-red-500 font-semibold">
            <i data-lucide="alert-circle" class="w-3 h-3 inline-block ml-1"></i>
            Minimum 10 words required
        </span>
    </div>
</div>

@once
@push('styles')
<style>
    /* TinyMCE Custom Styling for The Last Messenger Theme */
    .tox-tinymce {
        border-radius: 0.5rem !important;
        border: 1px solid rgba(0, 86, 179, 0.2) !important;
        overflow: hidden;
    }

    /* Dark mode styling */
    .dark .tox-tinymce {
        border-color: rgba(255, 255, 255, 0.1) !important;
    }

    /* Toolbar gradient for active states */
    .tox .tox-tbtn--enabled,
    .tox .tox-tbtn:hover {
        background: linear-gradient(135deg, rgba(0, 86, 179, 0.1) 0%, rgba(33, 136, 56, 0.1) 100%) !important;
    }

    /* Focus state */
    .tox-tinymce.tox-tinymce--focus {
        border-color: #0056b3 !important;
        box-shadow: 0 0 0 3px rgba(0, 86, 179, 0.1) !important;
    }

    /* RTL Support */
    [dir="rtl"] .tox-toolbar__group {
        flex-direction: row-reverse;
    }

    /* Loading animation */
    .editor-loading {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }

    /* Hide textarea while editor loads */
    .tinymce-textarea {
        opacity: 0;
        position: absolute;
        z-index: -1;
    }
</style>
@endpush

@push('scripts')
<!-- TinyMCE 6 CDN -->
<script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>

<script>
/**
 * TinyMCE Editor Alpine.js Component
 * Handles editor initialization, content management, and event handling
 */
function tinymceEditor(config) {
    return {
        id: config.id,
        name: config.name,
        language: config.language,
        direction: config.direction,
        height: config.height,
        required: config.required,
        disabled: config.disabled,
        placeholder: config.placeholder,

        editorInstance: null,
        editorReady: false,
        editorError: null,
        wordCount: 0,

        /**
         * Initialize TinyMCE editor instance
         */
        async initEditor() {
            this.editorError = null;

            // Check if TinyMCE is loaded
            if (typeof tinymce === 'undefined') {
                this.editorError = 'TinyMCE library failed to load. Please check your internet connection.';
                return;
            }

            try {
                // Remove existing instance if any
                if (this.editorInstance) {
                    this.editorInstance.remove();
                }

                // Get dark mode state from parent component
                const darkMode = this.$root.closest('[x-data]')?.darkMode ?? false;

                // Initialize TinyMCE
                const editors = await tinymce.init({
                    selector: `#${this.id}`,
                    license_key: 'gpl', // Free GPL license

                    // Layout
                    height: this.height,
                    menubar: false,
                    statusbar: true,
                    resize: true,

                    // Plugins
                    plugins: [
                        'advlist', 'autolink', 'lists', 'link', 'image', 'charmap',
                        'anchor', 'searchreplace', 'visualblocks', 'code', 'fullscreen',
                        'insertdatetime', 'media', 'table', 'help', 'wordcount',
                        'directionality', 'paste'
                    ],

                    // Toolbar configuration
                    toolbar: [
                        'undo redo | styles | bold italic underline strikethrough | forecolor backcolor',
                        'alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image media table | ltr rtl | code fullscreen help'
                    ].join(' | '),

                    // Content styling
                    content_style: `
                        body {
                            font-family: Cairo, Arial, sans-serif;
                            font-size: 16px;
                            line-height: 1.8;
                            color: ${darkMode ? '#e5e7eb' : '#1f2937'};
                            background: ${darkMode ? '#1f2937' : '#ffffff'};
                        }
                        body[dir="rtl"] {
                            text-align: right;
                        }
                        a {
                            color: #0056b3;
                            text-decoration: underline;
                        }
                        blockquote {
                            border-${this.direction === 'rtl' ? 'right' : 'left'}: 4px solid #0056b3;
                            padding-${this.direction === 'rtl' ? 'right' : 'left'}: 16px;
                            margin: 16px 0;
                            font-style: italic;
                            background: ${darkMode ? 'rgba(0, 86, 179, 0.1)' : 'rgba(0, 86, 179, 0.05)'};
                        }
                    `,

                    // Text direction
                    directionality: this.direction,

                    // Paste configuration
                    paste_as_text: false,
                    paste_remove_styles_if_webkit: true,
                    paste_merge_formats: true,

                    // Language
                    language: '{{ $tinyLanguage }}',

                    // Skin (theme)
                    skin: darkMode ? 'oxide-dark' : 'oxide',
                    content_css: darkMode ? 'dark' : 'default',

                    // Block formats
                    block_formats: 'Paragraph=p; Heading 1=h1; Heading 2=h2; Heading 3=h3; Heading 4=h4; Blockquote=blockquote; Preformatted=pre',

                    // Style formats
                    style_formats: [
                        { title: 'Headings', items: [
                            { title: 'Heading 1', format: 'h1' },
                            { title: 'Heading 2', format: 'h2' },
                            { title: 'Heading 3', format: 'h3' },
                            { title: 'Heading 4', format: 'h4' }
                        ]},
                        { title: 'Inline', items: [
                            { title: 'Bold', format: 'bold' },
                            { title: 'Italic', format: 'italic' },
                            { title: 'Underline', format: 'underline' },
                            { title: 'Strikethrough', format: 'strikethrough' },
                            { title: 'Superscript', format: 'superscript' },
                            { title: 'Subscript', format: 'subscript' },
                            { title: 'Code', format: 'code' }
                        ]},
                        { title: 'Blocks', items: [
                            { title: 'Paragraph', format: 'p' },
                            { title: 'Blockquote', format: 'blockquote' },
                            { title: 'Div', format: 'div' },
                            { title: 'Pre', format: 'pre' }
                        ]}
                    ],

                    // Font settings
                    font_family_formats: 'Cairo=Cairo, sans-serif; Arial=arial,helvetica,sans-serif; Courier New=courier new,courier,monospace; Times New Roman=times new roman,times,serif',
                    font_size_formats: '8px 10px 12px 14px 16px 18px 20px 24px 28px 32px 36px 48px',

                    // Image settings
                    image_advtab: true,
                    image_caption: true,

                    // Link settings
                    link_assume_external_targets: true,
                    link_title: false,
                    target_list: false,

                    // Misc
                    branding: false,
                    promotion: false,
                    elementpath: false,

                    // Mobile configuration
                    mobile: {
                        menubar: false,
                        toolbar_mode: 'sliding'
                    },

                    // Setup callback
                    setup: (editor) => {
                        // Store editor instance
                        this.editorInstance = editor;

                        // Editor initialization
                        editor.on('init', () => {
                            this.editorReady = true;

                            // Set placeholder if empty
                            if (!editor.getContent() && this.placeholder) {
                                editor.setContent(`<p style="color: #9ca3af;">${this.placeholder}</p>`);
                            }

                            // Update word count
                            this.updateWordCount(editor);

                            // Make textarea visible after editor loads
                            document.getElementById(this.id).style.visibility = 'visible';

                            // Reinitialize icons
                            this.$nextTick(() => {
                                if (typeof lucide !== 'undefined') {
                                    lucide.createIcons();
                                }
                            });
                        });

                        // Content change handler
                        editor.on('change keyup', () => {
                            this.updateWordCount(editor);
                        });

                        // Focus handler - remove placeholder
                        editor.on('focus', () => {
                            const content = editor.getContent();
                            if (content.includes('color: #9ca3af')) {
                                editor.setContent('');
                            }
                        });

                        // Blur handler - add placeholder if empty
                        editor.on('blur', () => {
                            if (!editor.getContent({ format: 'text' }).trim() && this.placeholder) {
                                editor.setContent(`<p style="color: #9ca3af;">${this.placeholder}</p>`);
                            }
                        });
                    }
                });

                if (editors && editors.length > 0) {
                    this.editorInstance = editors[0];
                }

            } catch (error) {
                console.error('TinyMCE initialization error:', error);
                this.editorError = error.message || 'Failed to initialize editor';
                this.editorReady = false;
            }
        },

        /**
         * Update word count display
         */
        updateWordCount(editor) {
            const wordCountPlugin = editor.plugins.wordcount;
            if (wordCountPlugin) {
                this.wordCount = wordCountPlugin.body.getWordCount();
            }
        },

        /**
         * Get editor content
         */
        getContent() {
            if (this.editorInstance) {
                return this.editorInstance.getContent();
            }
            return '';
        },

        /**
         * Set editor content
         */
        setContent(content) {
            if (this.editorInstance) {
                this.editorInstance.setContent(content);
            }
        },

        /**
         * Clear editor content
         */
        clearContent() {
            if (this.editorInstance) {
                this.editorInstance.setContent('');
            }
        },

        /**
         * Cleanup on component destroy
         */
        destroy() {
            if (this.editorInstance) {
                this.editorInstance.remove();
                this.editorInstance = null;
            }
        }
    };
}

// Make function globally available
window.tinymceEditor = tinymceEditor;
</script>
@endpush
@endonce
