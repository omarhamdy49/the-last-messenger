APP_NAME="The Last Messenger"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Queue: retry_after must exceed the longest job timeout on this connection.
# SyncYouTubePlaylistJob (YouTube import) declares $timeout = 3600; below that
# the queue treats a running import as abandoned and runs it a second time.
DB_QUEUE_RETRY_AFTER=3700

# YouTube import (admin media programs). Requires the yt-dlp binary and ffmpeg.
# Locally: brew install yt-dlp ffmpeg. Production: deploy stage 47-media-tools.
YT_DLP_PATH=yt-dlp
YT_DLP_TIMEOUT=600
YOUTUBE_MAX_EPISODES=100
# Netscape cookies.txt from a BURNER YouTube account (never your personal one) —
# clears the datacenter-IP "confirm you're not a bot" block. Leave blank to run
# cookieless. On prod keep the file outside releases, e.g. shared/youtube-cookies.txt.
YT_DLP_COOKIES=

# Cache driver selection:
#   - "file" or "database" — works out of the box, no extra services required.
#     These drivers do NOT support Cache::tags(); the codebase uses version-counter
#     key invalidation as a portable alternative.
#   - "redis" or "memcached" — required for production workloads. Also the only
#     drivers that support Cache::tags() natively. If you switch to one of these,
#     tag-based invalidation in LanguageCacheService will activate automatically.
#     Configure the REDIS_* / MEMCACHED_* variables below accordingly.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Quran API Configuration
QURAN_AUTH_API_URL=https://oauth2.quran.foundation/oauth2/token
# Trailing slash required — Guzzle base_uri drops the last segment without it.
QURAN_API_BASE_URL=https://apis.quran.foundation/content/api/v4/
QURAN_API_KEY=
QURAN_API_SECRET=

# Ask Quran AI (LLM + quran.ai MCP) — registered users only.
# QURAN_AI_PROVIDER selects the primary provider block below;
# QURAN_AI_FALLBACK_PROVIDER takes over when it 429s or is unreachable (empty = off).
QURAN_AI_PROVIDER=gemini
QURAN_AI_FALLBACK_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Google Gemini via its OpenAI-compatible endpoint. Get a key at
# https://aistudio.google.com/apikey — leave empty unless the provider is gemini.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.6-flash
# Bounds Gemini's thinking tokens, which bill at the (much higher) output rate.
GEMINI_REASONING_EFFORT=low
QURAN_MCP_URL=https://mcp.quran.ai
QURAN_MCP_TAFSIR=en-maarif-ul-quran
QURAN_AI_MONTHLY_QUOTA=10
QURAN_AI_MAX_CHARS=200

# Frontend origin allowed by CORS (set to your actual frontend URL in production)
FRONTEND_URL=http://localhost:3000

# Sanctum token expiration in minutes (43200 = 30 days). Keep this finite in production.
SANCTUM_TOKEN_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=tlm_

VITE_APP_NAME="${APP_NAME}"

# Social login (Laravel Socialite) — leave empty to hide the buttons entirely.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT="${APP_URL}/auth/google/callback"
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_REDIRECT="${APP_URL}/auth/facebook/callback"

# Quran Foundation Content API environment (QURAN_API_KEY/SECRET above). Secret is server-only.
QF_ENV=production

# Public API CORS: comma-separated exact origins allowed to call /api/v1
CORS_ALLOWED_ORIGINS=
