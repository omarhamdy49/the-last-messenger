# ===========================================================================
# config.env — provisioning configuration for The Last Messenger VPS
# ---------------------------------------------------------------------------
# Copy to config.env and fill in the blanks BEFORE running provision.sh:
#     cp config.env.example config.env && nano config.env
# Anything left blank that is a secret (DB/Redis passwords) is auto-generated
# and saved to /root/.tlm-credentials (chmod 600). Re-runs reuse those values.
# config.env is git-ignored — never commit real secrets.
# ===========================================================================

# --- Server identity -------------------------------------------------------
SERVER_IP="51.195.100.16"
APP_DOMAIN="rasoolallah.com"
APP_WWW="www.rasoolallah.com"
HOSTNAME="rasoolallah-prod"
TIMEZONE="Asia/Riyadh"          # matches app APP_TIMEZONE
SYSTEM_LOCALE="en_US.UTF-8"

# --- Deploy user (non-root, owns the app, used by CI over SSH) -------------
DEPLOY_USER="deployer"
# Public SSH key authorised for the deploy user. REQUIRED — paste the PUBLIC
# key whose PRIVATE half you will store as the GitHub secret SSH_PRIVATE_KEY.
DEPLOY_USER_PUBKEY=""

# --- Application layout -----------------------------------------------------
APP_DIR="/var/www/rasoolallah"          # base; holds releases/ current/ shared/
APP_REPO_BRANCH="main"

# --- PHP --------------------------------------------------------------------
PHP_VERSION="8.5"          # Ubuntu 26.04 ships PHP 8.5 natively (ondrej PPA has no resolute build)
PHP_FPM_MAX_CHILDREN="16"        # tuned for 4GB RAM / 2 vCPU (~70MB per worker)
PHP_FPM_START_SERVERS="4"
PHP_FPM_MIN_SPARE="2"
PHP_FPM_MAX_SPARE="6"
PHP_MEMORY_LIMIT="256M"
PHP_UPLOAD_MAX="100M"            # media uploads (spatie/medialibrary)
PHP_OPCACHE_JIT_BUFFER="64M"

# --- MySQL 8 ----------------------------------------------------------------
DB_NAME="the_last_messenger"
DB_USER="tlm_app"
DB_PASSWORD=""                   # blank -> auto-generated
DB_ROOT_PASSWORD=""              # blank -> auto-generated
MYSQL_INNODB_BUFFER_POOL="1G"    # ~25-30% of 4GB; leaves room for PHP+Redis
MYSQL_MAX_CONNECTIONS="100"

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=""                # blank -> auto-generated
REDIS_MAXMEMORY="256mb"          # cache + session store (queue stays on MySQL)

# --- Queue workers (Supervisor) --------------------------------------------
QUEUE_WORKERS="2"
QUEUE_CONNECTION="database"      # see README "Redis & queue design decision"

# --- TLS (Let's Encrypt) ----------------------------------------------------
CERTBOT_EMAIL="omarhamdy49@gmail.com"
LETSENCRYPT_STAGING="false"      # set true to test issuance without rate limits

# --- Swap -------------------------------------------------------------------
SWAP_SIZE_MB="2048"              # 4GB RAM -> 2GB swap; swappiness lowered to 10
