# The Last Messenger — MySQL 8 tuning (4GB RAM / 2 vCPU, content-heavy reads).
[mysqld]
# --- Networking: localhost only (firewalled anyway; defence in depth). ---
bind-address            = 127.0.0.1
skip-name-resolve       = 1
max_connections         = ${MYSQL_MAX_CONNECTIONS}

# --- Character set (matches utf8mb4 app schema). ---
character-set-server    = utf8mb4
collation-server        = utf8mb4_unicode_ci

# --- InnoDB ---
innodb_buffer_pool_size = ${MYSQL_INNODB_BUFFER_POOL}
innodb_buffer_pool_instances = 1
innodb_log_file_size    = 256M
innodb_redo_log_capacity = 512M
innodb_flush_method     = O_DIRECT
# 2 = flush to OS cache each commit, to disk once/sec. Big write-throughput win;
# at most ~1s of committed data at risk on a hard crash. Acceptable for a
# content site. Set to 1 for full ACID durability.
innodb_flush_log_at_trx_commit = 2
innodb_io_capacity      = 1000
innodb_io_capacity_max  = 2000
innodb_read_io_threads  = 4
innodb_write_io_threads = 4

# --- Memory caps (keep total RSS well under 4GB alongside PHP+Redis). ---
tmp_table_size          = 32M
max_heap_table_size     = 32M
table_open_cache        = 2000
thread_cache_size       = 16

# --- Slow query log (diagnose N+1 / missing indexes per CLAUDE.md §4). ---
slow_query_log          = 1
slow_query_log_file     = /var/log/mysql/slow.log
long_query_time         = 1
log_queries_not_using_indexes = 0

# --- Safety / correctness ---
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
