# ===========================================================================
# config.env — provisioning configuration for The Last Messenger VPS
# ---------------------------------------------------------------------------
# Copy to config.env and fill in the blanks BEFORE running provision.sh:
#     cp config.env.example config.env && nano config.env
# Anything left blank that is a secret (DB/Redis passwords) is auto-generated
# and saved to /root/.tlm-credentials (chmod 600). Re-runs reuse those values.
# config.env is git-ignored — never commit real secrets.
# ===========================================================================

# --- Server identity -------------------------------------------------------
SERVER_IP="51.195.100.16"
APP_DOMAIN="rasoolallah.com"
APP_WWW="www.rasoolallah.com"
HOSTNAME="rasoolallah-prod"
TIMEZONE="Asia/Riyadh"          # matches app APP_TIMEZONE
SYSTEM_LOCALE="en_US.UTF-8"

# --- Deploy user (non-root, owns the app, used by CI over SSH) -------------
DEPLOY_USER="deployer"
# Public SSH key authorised for the deploy user. REQUIRED — paste the PUBLIC
# key whose PRIVATE half you will store as the GitHub secret SSH_PRIVATE_KEY.
DEPLOY_USER_PUBKEY=""

# --- Application layout -----------------------------------------------------
APP_DIR="/var/www/rasoolallah"          # base; holds releases/ current/ shared/
APP_REPO_BRANCH="main"

# --- PHP --------------------------------------------------------------------
PHP_VERSION="8.5"          # Ubuntu 26.04 ships PHP 8.5 natively (ondrej PPA has no resolute build)
# 10, not 16. Measured 17 Aug 2026: under a 60-VU stress run only 7 children were ever
# spawned while load1 peaked at 1.15 of 2 cores — PHP CPU was the ceiling, never worker
# count. Meanwhile 16 x PHP_MEMORY_LIMIT=256M is 4GB of theoretical allocation on a 3.7GB
# box, and stage 10 sets vm.overcommit_memory=1, so the kernel never refuses an
# allocation — it OOM-kills, and the fattest process is mysqld. Raising this would buy
# nothing; lowering it removes the overcommit.
PHP_FPM_MAX_CHILDREN="10"        # tuned for 4GB RAM / 2 vCPU (~70MB per worker)
PHP_FPM_START_SERVERS="4"
PHP_FPM_MIN_SPARE="2"
PHP_FPM_MAX_SPARE="6"
PHP_MEMORY_LIMIT="256M"
PHP_UPLOAD_MAX="100M"            # media uploads (spatie/medialibrary)
PHP_OPCACHE_JIT_BUFFER="64M"

# --- MySQL 8 ----------------------------------------------------------------
DB_NAME="the_last_messenger"
DB_USER="tlm_app"
DB_PASSWORD=""                   # blank -> auto-generated
DB_ROOT_PASSWORD=""              # blank -> auto-generated
# 384M, not 1G. Measured 17 Aug 2026: of 65,536 pool pages, 18,261 held data and 47,269
# were free — ~720MB reserved and permanently idle for a 122MB database. 384M still holds
# the entire dataset several times over.
MYSQL_INNODB_BUFFER_POOL="384M"
# 40, not 100. Max_used_connections since boot is 12. The real ceiling is arithmetic:
# PHP_FPM_MAX_CHILDREN (10) + queue workers (4) + scheduler subprocesses (~3) + admin
# shells. Each connection reserves per-thread buffers, so 100 was paying for 88 that
# never existed.
MYSQL_MAX_CONNECTIONS="40"

# performance_schema auto-sizes off max_connections and costs ~150-250MB. Nothing on this
# box consumes it (no APM, no Percona toolkit); the slow query log below covers diagnosis.
# Set to "ON" temporarily if you ever need to profile.
MYSQL_PERFORMANCE_SCHEMA="OFF"

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=""                # blank -> auto-generated
REDIS_MAXMEMORY="256mb"          # cache + session store (queue stays on MySQL)

# --- Queue workers (Supervisor) --------------------------------------------
QUEUE_WORKERS="2"
QUEUE_CONNECTION="database"      # see README "Redis & queue design decision"

# YouTube imports run on their own `sync` queue with a dedicated worker: one
# playlist import holds a worker for minutes (yt-dlp runs once per video), so
# on the default queue it would starve everything behind it.
SYNC_QUEUE_WORKERS="1"           # >1 only if admins import concurrently
SYNC_QUEUE_TIMEOUT="3600"        # seconds for one whole playlist import

# Media view tracking (RecordMediaViewJob) runs on its own `tracking` queue:
# bursty micro-jobs that must never queue behind bulk/default work.
TRACKING_QUEUE_WORKERS="1"       # raise only if view volume outgrows one worker

# --- TLS (Let's Encrypt) ----------------------------------------------------
CERTBOT_EMAIL="omarhamdy49@gmail.com"
LETSENCRYPT_STAGING="false"      # set true to test issuance without rate limits

# --- Swap -------------------------------------------------------------------
SWAP_SIZE_MB="2048"              # 4GB RAM -> 2GB swap; swappiness lowered to 10
