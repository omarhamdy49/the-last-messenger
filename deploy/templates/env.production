APP_NAME="The Last Messenger"
APP_ENV=production
APP_KEY=${APP_KEY}
APP_DEBUG=false
APP_URL=https://${APP_DOMAIN}
APP_TIMEZONE=${TIMEZONE}

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=2
BCRYPT_ROUNDS=12

# Logging: daily rotation, warnings+ only in production.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (native MySQL 8, localhost) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=${DB_NAME}
DB_USERNAME=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}

# --- Sessions: Redis (HTTPS-only secure cookies). ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.${APP_DOMAIN}
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Queue: database-backed (durable). Processed by Supervisor workers.
#     Kept off Redis on purpose — the cache Redis uses LRU eviction, which
#     could drop queued jobs. See deploy/README.md. ---
QUEUE_CONNECTION=${QUEUE_CONNECTION}

# INVARIANT: retry_after MUST exceed the longest job timeout on this connection.
# SyncYouTubePlaylistJob declares $timeout = 3600. At the Laravel default of 90s
# the queue would consider a running import abandoned after 90 seconds, release
# it, and run it a second time concurrently — double the yt-dlp load and two
# writers racing on the same run's counters.
# Raise this whenever SYNC_QUEUE_TIMEOUT or that job's $timeout goes up.
DB_QUEUE_RETRY_AFTER=3700

# --- YouTube import (admin media programs) ---
#     yt-dlp + ffmpeg are installed by provisioning stage 47-media-tools.
#     An absolute path avoids depending on the worker's inherited PATH, which
#     under Supervisor is not the deploy user's login PATH.
YT_DLP_PATH=/usr/local/bin/yt-dlp
# Per-invocation ceiling. Deep fetches (metadata + subtitles) are the slow path;
# must stay well under the sync worker's --timeout (see supervisor-sync-worker).
YT_DLP_TIMEOUT=600
# Safety cap on videos imported per run. A truncated import is logged, never
# silently dropped.
YOUTUBE_MAX_EPISODES=100

# --- Cache: Redis (supports tags -> activates LanguageCacheService tag
#     invalidation per .env.example notes). ---
CACHE_STORE=redis
CACHE_PREFIX=tlm

MEMCACHED_HOST=127.0.0.1

# phpredis (C extension) — faster than predis; installed by stage 40.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_PORT=6379
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@${APP_DOMAIN}"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Quran API / Ask Quran AI — fill these in before enabling those features. ---
QURAN_AUTH_API_URL=https://oauth2.quran.foundation/oauth2/token
QURAN_API_BASE_URL=https://apis.quran.foundation/content/api/v4
QURAN_API_KEY=
QURAN_API_SECRET=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
QURAN_MCP_URL=https://mcp.quran.ai
QURAN_MCP_TAFSIR=en-maarif-ul-quran
QURAN_AI_MONTHLY_QUOTA=10
QURAN_AI_MAX_CHARS=200

# CORS origin — the public site is same-origin here.
FRONTEND_URL=https://${APP_DOMAIN}

SANCTUM_TOKEN_EXPIRATION=43200
VITE_APP_NAME="${APP_NAME}"

# Social login — fill to enable Google/Facebook buttons.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT="https://${APP_DOMAIN}/auth/google/callback"
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_REDIRECT="https://${APP_DOMAIN}/auth/facebook/callback"
